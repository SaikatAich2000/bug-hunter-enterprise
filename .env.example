# Bug Hunter Enterprise Configuration
# Copy to .env (or run: python scripts/gen_local_env_secrets.py, which copies it
# and fills the secrets for you), then ./deploy.sh (Docker) or run locally
# (see README "Local development").
#
# ⚠️  SECURITY NOTES:
# 1. Never commit .env to git — it contains credentials
# 2. Never commit secrets/firebase-admin.json — it contains private keys
# 3. Store credentials securely: environment variables, secret management, vault
# 4. Change BOOTSTRAP_ADMIN_PASSWORD on first login
# 5. Set SESSION_SECRET to a random value (generate with Python: secrets.token_hex(32))

# ═══════════════════════════════════════════════════════════════════════════
# DATABASE CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════
# For Docker Compose: set strong passwords on FIRST boot. Changing passwords
# later does NOT update the running PostgreSQL container — recreate the volume
# or ALTER password manually. Leave empty for local dev (uses SQLite).

POSTGRES_USER=bugtracker
POSTGRES_PASSWORD=replace_with_local_or_secret_store_value
POSTGRES_DB=bugtracker

# Override DATABASE_URL only for external databases (Azure, AWS RDS, an
# app-container deployment with no Compose, etc.)
# Format: postgresql+psycopg://user:password@host:port/dbname
# Leave unset for Docker Compose (auto-built from POSTGRES_* above)
# Leave unset for local dev (falls back to SQLite: bug_hunter.db)
# For app-container deployment WITHOUT Compose, the platform must inject a
# DATABASE_URL pointing to an EXTERNAL PostgreSQL service — never localhost,
# because the app container runs no database of its own.
#DATABASE_URL=

# PostgreSQL connection pool (ignored for SQLite)
#DB_POOL_SIZE=5
#DB_MAX_OVERFLOW=10

# Startup fail-fast guards (Postgres only; ignored for SQLite). Defaults are
# chosen for Azure Container Apps: a firewalled/slow database (or DDL
# waiting on another replica's lock) must fail fast instead of hanging the
# container at "Waiting for application startup" until the platform kills
# the replica. Raise them only if your Postgres is legitimately slow.
#DB_CONNECT_TIMEOUT_SECONDS=10
#DB_STATEMENT_TIMEOUT_MS=30000
#DB_LOCK_TIMEOUT_MS=10000
# Overall budget for all blocking DB work during startup (init + reconcile).
#DB_STARTUP_TIMEOUT_SECONDS=60


# ═══════════════════════════════════════════════════════════════════════════
# APPLICATION CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════

APP_NAME=Bug Hunter
# PRODUCT VERSION - THE SINGLE SOURCE OF TRUTH. There is no hardcoded copy
# anywhere in the code, Dockerfile, CI or release tooling: everything reads
# APP_VERSION from this file. Set it once per release; do not leave it blank
# (docker-compose.yml and the startup checks require it).
APP_VERSION=
APP_ENV=development
# Direct Python uses this file as-is (port 8000). Docker Compose overrides it
# to the externally reachable port (see docker-compose.yml APP_BASE_URL):
# direct = http://127.0.0.1:8000, docker = http://localhost:8765.
APP_BASE_URL=http://127.0.0.1:8000
LOG_LEVEL=INFO

# SIGNOZ OBSERVABILITY (OTLP/gRPC). Blank endpoint = telemetry off (console-only).
# Keep the real collector URL in .env / platform secrets — never in code.
# The http:// scheme here means cleartext gRPC (not REST).
#OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
#OTEL_SERVICE_NAME=bug-hunter
# Signals exported when the endpoint is set (each can be switched off):
#OTEL_TRACES_ENABLED=true
#OTEL_METRICS_ENABLED=true
#OTEL_LOGS_ENABLED=true
# Filter values in SigNoz by deployment environment (defaults to APP_ENV):
#OTEL_DEPLOYMENT_ENVIRONMENT=production
# Collector auth headers, extra resource attributes (comma-separated key=value):
#OTEL_EXPORTER_OTLP_HEADERS=
#OTEL_RESOURCE_ATTRIBUTES=
# Sampling: parentbased_always_on | always_on | always_off | traceidratio |
# parentbased_traceidratio (ratio via OTEL_TRACES_SAMPLER_ARG, default 1.0):
#OTEL_TRACES_SAMPLER=parentbased_always_on
# URL regexes kept out of server spans (health checks, static assets):
#OTEL_TRACES_EXCLUDED_URLS=/api/health,/static
# Log export: floor level, loggers to keep out of SigNoz (requests are traces),
# and redaction of sensitive attribute keys:
#OTEL_LOG_MIN_LEVEL=INFO
#OTEL_LOG_EXCLUDE_LOGGERS=uvicorn.access,watchfiles
#OTEL_LOG_REDACT_SENSITIVE=true
# Metrics export cadence (ms):
#OTEL_METRICS_EXPORT_INTERVAL_MS=60000
# Auto-instrumentation toggles:
#OTEL_INSTRUMENT_SQLALCHEMY=true
#OTEL_INSTRUMENT_HTTPX=true
# Console log format: text (default) or json (one JSON object per line)
#LOG_FORMAT=text

# Base Python Docker image (for private registries, use: private-registry/python:3.12-slim)
#BASE_IMAGE=python:3.12-slim

# Cross-origin allow-list (comma-separated). Blank = same-origin only (secure default)
# For cross-origin clients, set: CORS_ORIGINS=https://example.com,https://other.com
CORS_ORIGINS=

# Trust X-Forwarded-For header only when behind a trusted reverse proxy
TRUST_PROXY_FORWARDED_FOR=false
# Number of trusted proxies in front of the app: the client IP is the Nth
# X-Forwarded-For entry from the right (1 = a single reverse proxy).
TRUST_PROXY_HOP_COUNT=1

# Maximum request body size (bytes; default 60 MiB)
#MAX_REQUEST_BODY_BYTES=62914560

# API docs (/docs, /redoc, /openapi.json) are always on in development. A
# production deploy (APP_ENV=production or COOKIE_SECURE=true) hides them
# unless this is true.
ENABLE_API_DOCS=false


# ═══════════════════════════════════════════════════════════════════════════
# AUTHENTICATION & SESSIONS
# ═══════════════════════════════════════════════════════════════════════════

# Session secret (generate with: python -c "import secrets; print(secrets.token_hex(32))")
# Blank = a random per-process secret (sessions reset on restart; dev only).
# A production deploy refuses to start without a real value.
SESSION_SECRET=

# Session TTL in seconds (86400 = 24 hours)
SESSION_TTL_SECONDS=86400

# Reject session cookies issued before per-device sessions existed (they
# can't be revoked individually). Leave false during an upgrade window from
# 3.x, then turn on.
SESSION_REQUIRE_JTI=false

# HTTPS enforcement (set to true in production with valid SSL certificate)
COOKIE_SECURE=false

# Bootstrap admin — created on first run, together with the organization below, when no
# user with this email exists. Leave BOOTSTRAP_ADMIN_EMAIL empty to start with no account and
# let people create their organizations at /signup (ALLOW_PUBLIC_SIGNUP). A production deploy
# refuses the placeholder password.
# ⚠️  Change password immediately after first login via the profile menu
BOOTSTRAP_ADMIN_EMAIL=admin@bughunter.local
BOOTSTRAP_ADMIN_PASSWORD=replace_with_a_strong_local_only_password
BOOTSTRAP_ADMIN_NAME=Administrator
BOOTSTRAP_ORG_NAME=Default Organization

# Recovery only: when true, every boot resets the bootstrap admin's password to the value above,
# reactivates and promotes the account, and signs out its devices. Turn it off again afterwards.
BOOTSTRAP_ADMIN_RESET_PASSWORD=false

# Auto-login convenience (skip login screen)
# ⚠️  SECURITY: Only enable on trusted local/dev deployments
AUTO_LOGIN_ENABLED=false

# Password policy
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_COMPLEXITY=true
FORGOT_PASSWORD_ENUMERATION_SAFE=true

# Reject passwords found in public breach corpora (Have I Been Pwned k-anonymity
# range API: only a 5-character hash prefix leaves the server; an outage never
# blocks a password change).
PASSWORD_BREACH_CHECK_ENABLED=true

# Per-account lockout: after LOGIN_FAIL_LIMIT failed sign-ins within
# LOGIN_FAIL_WINDOW_SECONDS, the account is locked for LOGIN_LOCKOUT_SECONDS
# (0 disables). Per process, like the per-IP login rate limit.
#LOGIN_FAIL_LIMIT=10
#LOGIN_FAIL_WINDOW_SECONDS=900
#LOGIN_LOCKOUT_SECONDS=900


# ═══════════════════════════════════════════════════════════════════════════
# ORGANIZATIONS, TWO-FACTOR, WEBHOOKS & PRIVACY
# ═══════════════════════════════════════════════════════════════════════════

# Anyone may create an organization (and become its first admin) at /signup. Turn off for a
# closed installation: organizations then come from the bootstrap admin and invitations only.
ALLOW_PUBLIC_SIGNUP=true

# bcrypt cost of new password hashes (minimum 10). Existing hashes keep verifying at their cost.
BCRYPT_ROUNDS=12

# Two-factor sign-in with an authenticator app. Each user still opts in under Account settings.
TOTP_ENABLED=true
TOTP_RECOVERY_CODE_COUNT=10

# Encrypts 2FA secrets and webhook signing secrets in the database (recommended in production).
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep it with your other secrets: values written under a key cannot be read without it.
FIELD_ENCRYPTION_KEY=

# Contact address shown on the public privacy page (/privacy).
PRIVACY_CONTACT_EMAIL=

# Audit-trail rows older than this many days are deleted daily (0 keeps everything). Reports built
# from history (status changes, time to resolution) only cover this window.
AUDIT_RETENTION_DAYS=365

# Outbound webhooks (Organization > Webhooks). Targets on private networks (localhost, RFC 1918,
# link-local) are refused unless you allow them, e.g. for a listener inside your own network.
WEBHOOK_TIMEOUT_SECONDS=8
WEBHOOK_ALLOW_PRIVATE_NETWORKS=false

# Prometheus counters at GET /api/metrics (404 while off). With a token, send
# "Authorization: Bearer <token>".
METRICS_ENABLED=false
METRICS_TOKEN=


# ═══════════════════════════════════════════════════════════════════════════
# EMAIL & NOTIFICATIONS
# ═══════════════════════════════════════════════════════════════════════════

# Backend: "console" (log to stdout), "smtp" (real mail), or "disabled"
EMAIL_BACKEND=console
EMAIL_FROM=Bug Hunter <bughunter@localhost>

# SMTP Configuration (used when EMAIL_BACKEND=smtp)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your_app_password_or_smtp_password
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT=10

# Email Digest (batch notifications into one daily email)
EMAIL_DIGEST_ENABLED=false

# 5-field cron format: minute hour day month day-of-week
# Examples: "0 8 * * *" = every day at 8am; "0 8 * * 1-5" = weekdays 8am
EMAIL_DIGEST_CRON=

# Timezone for email digest (IANA name; "UTC" if blank)
# Examples: "America/New_York", "Asia/Kolkata", "Europe/London"
EMAIL_DIGEST_TIMEZONE=

# Lookback hours for digest (must be >= 2x gap between runs; daily = 50, weekly = 336)
EMAIL_DIGEST_LOOKBACK_HOURS=50


# ═══════════════════════════════════════════════════════════════════════════
# GITHUB BRANCH CREATION (Optional)
# ═══════════════════════════════════════════════════════════════════════════
# Disabled by default. Two credential sources exist, in this order:
#   1. a per-project PAT saved in Project Git Settings (encrypted at rest), then
#   2. GITHUB_TOKEN below, a legacy deployment-wide fallback used only by
#      projects that have no credential of their own.
# Leave both blank to run without any Git integration.
GIT_BRANCH_CREATION_ENABLED=false
# Destructive remote branch removal is independently disabled by default.
GIT_BRANCH_DELETION_ENABLED=false


# Deployment DEFAULTS. A saved non-empty project value always wins over these,
# and these are never substituted into a project that already has a value.
GITHUB_API_URL=https://api.github.com
GITHUB_ORGANIZATION=
GITHUB_DEFAULT_BASE_BRANCH=dev

# Optional legacy fallback PAT (fine-grained). Never copied into the database,
# never returned to a browser, never logged or audited.
GITHUB_TOKEN=

# Server-only Fernet key protecting project Git credentials at rest. Required
# only to SAVE a project credential; without it, projects fall back to
# GITHUB_TOKEN. Generate once and keep it in the platform secret store:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotating or losing it makes existing project credentials unreadable (they must
# be re-entered). It is never derived from SESSION_SECRET.
GIT_CREDENTIAL_ENCRYPTION_KEY=

# Optional approved corporate CA bundle (PEM) for Linux containers behind TLS
# interception. Blank (default) = verify with the OS trust store via
# truststore. When set, point at a read-only mounted PEM file. A missing or
# invalid file fails closed; verification can never be disabled.
GIT_CA_BUNDLE_FILE=

GITHUB_CONNECT_TIMEOUT_SECONDS=5
GITHUB_READ_TIMEOUT_SECONDS=15
GITHUB_MAX_RETRIES=2
# First 25 Unicode title characters used before safe slug creation (minimum 1).
GITHUB_BRANCH_TITLE_MAX_LENGTH=25
GITHUB_BRANCH_NAME_MAX_LENGTH=120


# ═══════════════════════════════════════════════════════════════════════════
# REPORTS
# ═══════════════════════════════════════════════════════════════════════════

MAX_REPORT_ROWS=50000


# ═══════════════════════════════════════════════════════════════════════════
# WEB PUSH NOTIFICATIONS (Firebase Cloud Messaging)
# ═══════════════════════════════════════════════════════════════════════════
# Optional browser web push via Firebase. Leave empty to disable.
# Setup: https://console.firebase.google.com → Cloud Messaging → Service Accounts

WEB_PUSH_ENABLED=false

# Firebase credentials: one of two methods (file path OR JSON inline)
# Method 1: File path (recommended for Docker)
FCM_CREDENTIALS_FILE=secrets/firebase-admin.json

# Method 2: Inline JSON (raw or base64-encoded; set if FCM_CREDENTIALS_FILE is empty)
#FCM_CREDENTIALS_JSON=

# Firebase Web SDK config (from console → Project Settings → General)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_VAPID_KEY=


# ═══════════════════════════════════════════════════════════════════════════
# SLEUTH AI ASSISTANT (Optional)
# ═══════════════════════════════════════════════════════════════════════════
# Optional in-app assistant for Q&A and action automation with LLM grounding.

# Cloud LLM layer (requires API key from a provider)
SLEUTH_CLOUD_ENABLED=0

# Primary provider: Groq (free tier, recommended)
# Get key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional fallback provider: OpenRouter (supports multiple models)
#OPENROUTER_API_KEY=
#OPENROUTER_MODEL=qwen/qwen-2.5-7b-instruct:free

# Retrieval-Augmented Generation over bugs, comments and SLEUTH_DOCS_DIR
# (needs chromadb and a Gemini embeddings key)
SLEUTH_RAG_ENABLED=0
#GEMINI_API_KEY=
#GEMINI_EMBED_MODEL=text-embedding-004

# Keyword grounding over real bug records (no vector DB) and a citation check
# that flags bug numbers an answer cites without evidence (cloud layer only)
SLEUTH_RETRIEVAL_ENABLED=0
SLEUTH_VERIFY_ANSWERS=0

# Read-only multi-step agent: a few lookups before answering (never writes)
SLEUTH_AGENT_ENABLED=0
SLEUTH_AGENT_MAX_STEPS=4

# Fully LLM-driven tool-calling agent.
# Off by default; when on, this becomes the SOLE engine for every chat turn
# except confirm yes/no (no rule-engine fallback underneath it). Requires
# SLEUTH_CLOUD_ENABLED=1 plus a provider key above. Every mutating tool call
# (create/transition/assign/comment/sprint lifecycle) always stops for
# explicit user confirmation first; there is no delete tool at all.
SLEUTH_LLM_TOOLS_ENABLED=0
SLEUTH_LLM_TOOLS_MAX_ROUNDS=4

# LLM-as-judge: flags low-confidence answers with a "please verify" note
SLEUTH_EVAL_ENABLED=0
SLEUTH_EVAL_MIN_SCORE=0.5

# Advanced tuning (optional; defaults shown)
#SLEUTH_CLOUD_TIMEOUT_S=20
#SLEUTH_CLOUD_MAX_TOKENS=600
#SLEUTH_CLOUD_TEMPERATURE=0.6
#SLEUTH_CLOUD_TEMPERATURE_TOOLS=0.0
#SLEUTH_CLOUD_FREQUENCY_PENALTY=0.3
#SLEUTH_CLOUD_PRESENCE_PENALTY=0.2
#SLEUTH_ANSWER_MAX_CHARS=4000
#SLEUTH_RAG_TOP_K=5
#SLEUTH_CHAT_MEMORY_ENABLED=true
#SLEUTH_RAG_DIR=.sleuth_rag
#SLEUTH_DOCS_DIR=docs

# Optional local LLM (llama.cpp, needs `pip install llama-cpp-python` and a GGUF
# model). Dormant when the model file is absent.
#SLEUTH_LLM_MODEL_PATH=models/sleuth.gguf
#SLEUTH_LLM_CTX_LEN=1024
#SLEUTH_LLM_THREADS=1
#SLEUTH_LLM_MAX_TOKENS=120
#SLEUTH_LLM_TIMEOUT_S=12
# Unload the model after this many idle seconds; load only when free RAM is at
# least model size x SLEUTH_LLM_RAM_HEADROOM.
#SLEUTH_LLM_IDLE_UNLOAD_S=600
#SLEUTH_LLM_RAM_HEADROOM=1.4

