{
  "name": "bug-hunter-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "description": "Bug Hunter — React 19 + JSX single-page app, built with Vite into app/static. The product version is NOT here: it comes from APP_VERSION in .env (see .env.example).",
  "scripts": {
    "dev": "vite",
    "vendor": "node scripts/vendor-firebase.mjs",
    "clean:assets": "node -e \"require('fs').rmSync('../app/static/assets',{recursive:true,force:true})\"",
    "build": "npm run clean:assets && node scripts/vendor-firebase.mjs && vite build",
    "lint": "eslint src",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "dompurify": "^3.4.16",
    "firebase": "^13.0.0",
    "qrcode-generator": "^1.4.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.5.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "axe-core": "^4.13.0",
    "eslint": "^10.12.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.5",
    "source-map-js": "^1.2.2",
    "eslint-plugin-react": {
      "eslint": "$eslint"
    },
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    }
  }
}
