# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/

# --- Virtualenvs ---
.venv/
venv/
env/

# --- Test / coverage artefacts ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/

# --- Local secrets ---
# IMPORTANT: never commit a real .env. Use .env.example as the template.
.env
.env.local
.env.*.local

# --- Local databases (SQLite fallback for dev) ---
*.db
*.sqlite
*.sqlite3
bug_hunter.db

# --- Sleuth (AI assistant) ---
# Local LLM model files are large (300+ MB) and are downloaded
# per-deployment via models/README.md. They should never be
# committed to git.
models/*.gguf
models/*.bin
models/*.safetensors

# --- Editors / IDEs ---
.vscode/
.idea/
*.swp
*.swo
*.iml

# --- OS noise ---
.DS_Store
Thumbs.db

# --- Node (in case anyone runs frontend tooling) ---
node_modules/
npm-debug.log*

# --- SonarQube scanner artefacts ---
# Reports generated by `pytest --cov` and the JUnit exporter — consumed
# by sonar-scanner, then re-generated on every scan.
coverage.xml
junit.xml
# sonar-scanner's local work directory.
.scannerwork/
.sonar/
# Exported by scripts/sonar-export.ps1 — regenerated on demand.
sonar-issues.json
sonar-issues.csv
sonar-hotspots.json
sonar-hotspots.csv

# --- AI assistant / agent scratch ---
.claude/
.aider*
.cursor/
.continue/

# --- Playwright session artefacts (recordings, traces, MCP scratchpad) ---
.playwright-mcp/
playwright-report/
test-results/
*.har

# --- Generated API artifacts ---
# Produced by scripts/gen-api-docs.py from the live FastAPI app. The
# canonical source of truth is the app itself — browse GET /openapi.json
# or Swagger UI at /docs on a running instance. Regenerate locally with:
#     python scripts/gen-api-docs.py
docs/api/openapi.json
docs/api/openapi.yaml
docs/api/Bug-Hunter-Enterprise.postman_collection.json
docs/api/curl.md

# --- UI test scratchpad ---
uitest.db
